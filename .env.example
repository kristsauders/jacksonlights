# Copy to .env (local) or set as Application Settings in Azure App Service.

# --- Remote Falcon (required for show status / song requests) ---
REMOTE_FALCON_ACCESS_CODE=
REMOTE_FALCON_SECRET_KEY=

# --- Admin area (required for the Admin tab, uploads and feedback) ---
# Without ADMIN_PASSWORD the admin login returns 500 and no admin token can be
# issued or verified — the admin API fails closed.
ADMIN_PASSWORD=

# Signing secret for the admin session cookie. Optional: falls back to
# ADMIN_PASSWORD. Set it to a separate long random value (e.g.
# `openssl rand -base64 48`) so rotating one doesn't force the other to change.
# There is NO built-in default — a missing secret means no token validates.
ADMIN_JWT_SECRET=
